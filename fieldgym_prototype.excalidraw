      "boundElements": null,
      "updated": 1794232323481,
      "created": 1794232276872,
      "link": null,
      "locked": false,
      "text": "U grafů bude potřeba,\naby pokud se v sidebaru\nbude filtrovat, aby buď:\n1) grafy zešedly a svítila\njenom položka z filtru\n(např. box)\n2) Graf byl nahrazen\ntextem (např. box tvoří\n22 % všech aktivit)",
      "fontSize": 29.360000000000014,
      "baseFontSize": 43.360000000000014,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "DUQYC_TvTNzv5bFfwxxSt",
      "originalText": "U grafů bude potřeba, aby pokud se v sidebaru bude filtrovat, aby buď:\n1) grafy zešedly a svítila jenom položka z filtru (např. box)\n2) Graf byl nahrazen textem (např. box tvoří 22 % všech aktivit)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
